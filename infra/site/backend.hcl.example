# Copy to backend.hcl (gitignored) and fill in. Values come from:
#   tofu -chdir=../bootstrap output -raw state_bucket
bucket       = "wtf-terminal-tfstate-<account-id>"
key          = "site/terraform.tfstate"
region       = "us-east-1"
profile      = "personal"
encrypt      = true
use_lockfile = true
